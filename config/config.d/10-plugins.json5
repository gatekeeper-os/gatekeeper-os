// OS plugins and their configuration.
//
// Phase 1 ships this fragment EMPTY on purpose. The kernel (`clawos-kernel`) and `gatekeeper-fs` do not exist
// until Phase 3 and nothing is published, so declaring `entries.clawos-kernel: { enabled: true }` here would
// (a) make upstream report a stale config entry for a plugin it cannot find, and (b) assert an enablement the
// system cannot actually honour. Phase 3 adds the entries in the same change that adds the plugins.
//
// The Phase 3 shape, for reference:
//   plugins: { entries: {
//     "clawos-kernel": { enabled: true, config: {
//       operators: [], autoApprove: [],
//       install: { allowSources: ["npm:@clawos/*", "clawhub:@clawos/*"] },
//       egress: { denyPatterns: ["(?i)api[_-]?key\\s*[:=]", "grant:[a-z0-9]{8}"] },
//       audit: { llm: false },
//     } },
//     "gatekeeper-fs": { enabled: true, config: { roots: [] } },
//   } },
//   hooks: { internal: { entries: {
//     "clawos-bootstrap": { enabled: true }, "clawos-lifecycle": { enabled: true },
//   } } },
{}
