{
  "name": "gatekeeper-os",
  "version": "0.1.0-beta.4",
  "private": true,
  "description": "GatekeeperOS: capability-based access and deferred approvals for OpenClaw",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "pnpm build && pnpm -r --filter './packages/**' run typecheck",
    "test": "pnpm build && vitest run",
    "lint": "eslint . && pnpm run check:catalog && pnpm run check:secrets",
    "check:catalog": "tsx scripts/check-catalog.ts",
    "check:secrets": "bash scripts/check-secrets.sh",
    "conformance": "tsx packages/gkos-conformance/src/run.ts",
    "dev:gateway": "tsx scripts/dev-gateway.ts",
    "vm:up": "bash scripts/vm/up.sh",
    "vm:test": "bash scripts/vm/test.sh",
    "validate:plugins": "node scripts/check-plugin-metadata.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "8.42.0",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gatekeeper-os/gatekeeper-os.git"
  }
}
