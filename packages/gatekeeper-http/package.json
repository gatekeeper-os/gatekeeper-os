{
  "name": "@clawkeepers/gatekeeper-http",
  "version": "0.0.0",
  "description": "OpenAPI-driven generic REST gatekeeper (v1.1, plan \u00a79 Phase 8).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "NOTICE",
    "dist",
    "openclaw.plugin.json",
    "config.schema.json",
    "hooks",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node ../../scripts/check-plugin-metadata.mjs ."
  },
  "dependencies": {
    "@clawkeepers/shared": "workspace:*",
    "@clawkeepers/gatekeeper-kit": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.2 <2026.11.0",
      "minGatewayVersion": "2026.9.2"
    },
    "build": {
      "openclawVersion": "2026.9.2",
      "pluginSdkVersion": "2026.9.2"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clawkeeper/openclaw-os.git",
    "directory": "packages/gatekeeper-http"
  },
  "private": true
}
