{
  "id": "gatekeeper-github",
  "name": "GitHub Gatekeeper",
  "description": "Mediates agent access to GitHub repositories, issues, and pull requests.",
  "contracts": {
    "tools": []
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "clientId": {
        "type": "string"
      },
      "clientSecret": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "provider",
          "id"
        ],
        "properties": {
          "source": {
            "const": "env"
          },
          "provider": {
            "const": "default"
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          }
        }
      },
      "apiBase": {
        "type": "string",
        "const": "https://api.github.com"
      },
      "publicOrigin": {
        "type": "string"
      },
      "synchronousActions": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": [
            "gk_github_issue_create",
            "gk_github_issue_comment",
            "gk_github_pull_comment",
            "gk_github_pull_review"
          ]
        }
      }
    },
    "required": [
      "clientId",
      "clientSecret",
      "publicOrigin"
    ]
  },
  "clawos": {
    "gatekeeper": {
      "vendor": "github",
      "apiVersion": 1
    }
  }
}
