{
  "name": "@clawos/cli",
  "version": "0.1.0",
  "description": "The clawos binary: install, cells, update, rollback, backups, config apply, blueprints.",
  "type": "module",
  "bin": { "clawos": "./bin/clawos.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
