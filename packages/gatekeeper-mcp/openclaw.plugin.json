{
  "id": "gatekeeper-mcp",
  "name": "MCP Gatekeeper",
  "description": "Control-plane MCP boundary; tool execution disabled pending STOP2.",
  "contracts": {
    "tools": []
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "servers": {
        "type": "array",
        "default": [],
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "endpoint",
            "operatorId",
            "credentialEnv"
          ],
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "demo"
              ]
            },
            "endpoint": {
              "type": "string",
              "maxLength": 2048
            },
            "operatorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "credentialEnv": {
              "type": "string",
              "pattern": "^CLAWOS_MCP_[A-Z][A-Z0-9_]{0,63}$"
            }
          }
        }
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "clawos": {
    "gatekeeper": {
      "vendor": "mcp",
      "apiVersion": 1
    }
  }
}
