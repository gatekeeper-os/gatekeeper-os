{
  "name": "@clawos/gatekeeper-mcp",
  "version": "0.0.0",
  "description": "Wraps any MCP server behind the gatekeeper model (v1.1, plan §9 Phase 8).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "openclaw.plugin.json", "config.schema.json", "hooks", "README.md"],
  "scripts": { "build": "tsup src/index.ts --format esm --dts --clean", "test": "vitest run", "typecheck": "tsc -p tsconfig.json --noEmit", "validate": "openclaw plugins validate --entry ./dist/index.js" },
  "dependencies": { "@clawos/shared": "workspace:*", "@clawos/gatekeeper-kit": "workspace:*" },
  "peerDependencies": { "openclaw": "catalog:" },
  "devDependencies": { "tsup": "catalog:", "typescript": "catalog:", "vitest": "catalog:", "@types/node": "catalog:" },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": { "pluginApi": ">=2026.9.2 <2026.11.0", "minGatewayVersion": "2026.9.2" },
    "build": { "openclawVersion": "2026.9.2", "pluginSdkVersion": "2026.9.2" }
  }
}
