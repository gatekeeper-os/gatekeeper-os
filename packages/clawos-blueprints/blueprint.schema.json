{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "version", "workspaceFiles", "toolPolicy", "sandbox"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "workspaceFiles": { "type": "array", "items": { "type": "string" } },
    "skills": { "type": "array", "items": { "type": "string" } },
    "toolPolicy": { "type": "object", "properties": { "profile": { "type": "string" }, "allow": { "type": "array", "items": { "type": "string" } }, "deny": { "type": "array", "items": { "type": "string" } } } },
    "sandbox": { "type": "object", "properties": { "mode": { "enum": ["off", "non-main", "all"] }, "workspaceAccess": { "enum": ["none", "ro", "rw"] } } },
    "expectedGatekeepers": { "type": "array", "items": { "type": "string" } },
    "bindingsHint": { "type": "string" },
    "model": { "type": "string" }
  }
}
