{
  "id": "gkos-gatekeeper-fs",
  "name": "Filesystem Gatekeeper",
  "description": "Mediates agent access to specific host directories.",
  "contracts": {
    "tools": [
      "gk_fs_dir_list",
      "gk_fs_file_read",
      "gk_fs_file_write"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "roots": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "gkos": {
    "gatekeeper": {
      "vendor": "fs",
      "apiVersion": 1
    }
  },
  "version": "0.1.0-beta.4"
}
