{
  "name": "@gatekeeper-os/gatekeeper-fs",
  "version": "0.1.0-beta.2",
  "description": "Scoped host-directory gatekeeper for GatekeeperOS.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "openclaw.plugin.json",
    "deploy-inputs.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node ../../scripts/check-plugin-metadata.mjs ."
  },
  "dependencies": {
    "@gatekeeper-os/shared": "workspace:0.1.0-beta.2",
    "@gatekeeper-os/gatekeeper-kit": "workspace:0.1.0-beta.2",
    "typebox": "catalog:"
  },
  "peerDependencies": {
    "openclaw": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.2 <2026.11.0",
      "minGatewayVersion": "2026.9.2"
    },
    "build": {
      "openclawVersion": "2026.9.2",
      "pluginSdkVersion": "2026.9.2"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gatekeeper-os/gatekeeper-os.git",
    "directory": "packages/gkos-gatekeeper-fs"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
