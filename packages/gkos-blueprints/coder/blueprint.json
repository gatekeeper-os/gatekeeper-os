{
  "name": "coder",
  "version": "0.1.0",
  "description": "Sandboxed coding agent with scoped filesystem and exec inside a container.",
  "workspaceFiles": [
    "AGENTS.md",
    "SOUL.md",
    "README.md"
  ],
  "skills": [],
  "toolPolicy": {
    "profile": "messaging",
    "allow": [
      "group:fs",
      "exec"
    ],
    "deny": [
      "browser"
    ]
  },
  "sandbox": {
    "mode": "all",
    "workspaceAccess": "rw"
  },
  "expectedGatekeepers": [
    "fs",
    "github"
  ],
  "policy": "runtime"
}
