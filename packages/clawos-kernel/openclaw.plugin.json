{
  "id": "clawos-kernel",
  "name": "OpenClaw OS Kernel",
  "description": "Capability model, gatekeeper registry, approval queue, and audit for OpenClaw OS.",
  "contracts": {
    "tools": [
      "os_request_access",
      "os_list_grants",
      "gk_fs_dir_list",
      "gk_fs_file_read",
      "gk_fs_file_write",
      "gk_mcp_demo_read_note",
      "gk_mcp_demo_append_note"
    ],
    "trustedToolPolicies": [
      "clawos-capability-policy"
    ],
    "gatewayMethodDispatch": [
      "os.status",
      "os.grants.list",
      "os.grants.introduce",
      "os.grants.revoke",
      "os.approvals.list",
      "os.approvals.apply",
      "os.approvals.reject",
      "os.approvals.revert",
      "os.gatekeepers.list",
      "os.gatekeepers.connect",
      "os.audit.query",
      "os.maintenance.set"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "operators": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "channel",
            "senderId"
          ],
          "properties": {
            "channel": {
              "type": "string"
            },
            "senderId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "autoApprove": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "install": {
        "type": "object",
        "properties": {
          "allowSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowHashes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "egress": {
        "type": "object",
        "properties": {
          "denyPatterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "audit": {
        "type": "object",
        "properties": {
          "llm": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "maintenance": {
        "type": "boolean"
      },
      "notify": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "clawos": {
    "kernel": true,
    "apiVersion": 1
  },
  "cliCommands": [
    {
      "name": "os",
      "description": "OpenClaw OS kernel administration",
      "hasSubcommands": true
    }
  ],
  "version": "0.1.0-beta.1"
}
